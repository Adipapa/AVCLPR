# AVCLPR v2 environment template
# NEVER commit real credentials, database passwords, API tokens or camera passwords.
NODE_ENV=development
PORT=3000
V2_PORT=3100
CORS_ORIGINS=http://localhost:5173
AVCLPR_AUTH_SECRET=replace-with-at-least-32-random-characters
AVCLPR_BOOTSTRAP_SECRET=replace-with-a-one-time-bootstrap-secret
DATABASE_URL=postgresql://avclpr:change-me@localhost:5432/avclpr
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-random-service-token
VEHICLE_MODEL_PATH=models/yolo11n.pt
PLATE_MODEL_PATH=models/plate_detector.pt
AI_CONFIDENCE_THRESHOLD=0.35
AI_IMAGE_SIZE=640
AI_FRAME_INTERVAL=5
AI_JPEG_QUALITY=80
AI_FRAME_QUEUE_SIZE=2
RTSP_RECONNECT_SECONDS=3
RTSP_FRAME_TIMEOUT_SECONDS=15
PLATE_CONFIDENCE_THRESHOLD=0.30
OCR_CONFIDENCE_THRESHOLD=35
PLATE_IMAGE_SIZE=640
OCR_PSM=7
AI_MODEL_VERSION=avclpr-ai-0.9
TRACKER_IOU_THRESHOLD=0.20
TRACKER_MAX_MISSED_FRAMES=30
PLATE_ASSOC_IOU_THRESHOLD=0.01
PLATE_ASSOC_CENTER_DISTANCE=0.35
EVENT_MIN_FRAMES=3
EVENT_DEDUP_SECONDS=30
EVENT_MAX_RECENT_EVENTS=5000
EVIDENCE_ROOT=./data/evidence
EVIDENCE_RETENTION_DAYS=90
EDGE_SITE_ID=SITE-01
EDGE_SYNC_INTERVAL_SECONDS=10
EDGE_SYNC_BATCH_SIZE=100
EDGE_QUEUE_DB=./data/edge-sync.sqlite3
LOG_LEVEL=info
# Dashboard Vite override: VITE_API_URL=http://localhost:3100/api/v2
