# AVCLPR v2 environment template
# Never commit real credentials or camera passwords.

NODE_ENV=development
PORT=4000

# API security
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# Central database (production: PostgreSQL)
DATABASE_URL=postgresql://avclpr:change-me@localhost:5432/avclpr

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-random-service-token

# Evidence storage
EVIDENCE_ROOT=./data/evidence
EVIDENCE_RETENTION_DAYS=90

# Edge sync
EDGE_SITE_ID=SITE-01
EDGE_SYNC_INTERVAL_SECONDS=10

# Logging
LOG_LEVEL=info
